OPENAI_API_KEY=sk-...

# Modelo (padrão testado: gpt-5.4-mini + reasoning medium — melhor equilíbrio qualidade/latência)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium

AGENT_NAME=Sofia

# 🔒 TESTE COM NÚMERO PESSOAL: o bot só responde estes números (com DDI+DDD, separados por vírgula).
# Sem isso ele NÃO responde ninguém. Para produção (número dedicado) use REPLY_TO_ALL=true.
ALLOWED_NUMBERS=5531999999999
REPLY_TO_ALL=false

# Vendedora que recebe o lead aquecido (nome, número e resumo). Números sempre do Brasil.
SELLER_NAME=Flavia
SELLER_WHATSAPP=5531993144382
# Score a partir do qual o lead é considerado aquecido
HANDOFF_SCORE=60

# Segundos esperando o lead terminar de mandar mensagens picadas antes de responder
BUFFER_SECONDS=8
# Se alguém responder manualmente no chat, o bot fica pausado nesse chat por X minutos
HUMAN_PAUSE_MINUTES=180

# Opcional: conectar por código em vez de QR (seu número com DDI)
# WA_PAIRING_NUMBER=5531999999999
